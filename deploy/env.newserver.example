# ============================================================================
#  D&J Webmail — .env for the NEW self-hosted server (Windows / WAMP)
#  Copy this file to the project root on the new server and rename to  .env
#  (exact name, no extension). Fill in the four DB values + the two passwords.
# ============================================================================

# --- Application ------------------------------------------------------------
APP_NAME="D&J Webmail"
# The address users will type in the browser. Use https:// once SSL is installed.
# e.g. https://mailbox.djgroupllc.net   (or the new domain / server address)
APP_URL=https://CHANGE-ME
APP_DEBUG=false
SESSION_LIFETIME=28800
MAIL_PER_PAGE=15

# --- Performance / polling (this is a dedicated box, so the fast values) -----
LIVE_SYNC_INTERVAL=60
MAIL_POLL_INTERVAL=30
FILTER_MIN_INTERVAL=30

# --- Database (the NEW server's MySQL) --------------------------------------
# Create a database and a user in WAMP's phpMyAdmin, grant the user ALL on it,
# then import the .sql you exported from the old (Hostinger) server into it.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=CHANGE-ME
DB_USER=CHANGE-ME
# Plain password is fine here. If it contains  #  &  ;  +  use the _B64 line
# instead (run:  php deploy/encode-secret.php "your-password" ) and DELETE the
# plain DB_PASSWORD line below.
DB_PASSWORD=CHANGE-ME
# DB_PASSWORD_B64=

# --- Shared mailbox (IMAP/SMTP) — COPY THESE UNCHANGED FROM THE OLD SERVER ---
#  The email itself does NOT move with the app. It stays on its current mail
#  host, so these stay exactly the same. Only the password must be filled in.
IMAP_HOST=p3plzcpnl507129.prod.phx3.secureserver.net
IMAP_PORT=993
IMAP_ENCRYPTION=ssl
IMAP_VALIDATE_CERT=false

SMTP_HOST=p3plzcpnl507129.prod.phx3.secureserver.net
SMTP_PORT=465
SMTP_ENCRYPTION=ssl
SMTP_VALIDATE_CERT=false

MAILBOX_EMAIL=support@bebenailsmd.com
# The mailbox password (same one used on the old server). Plain is fine; use
# _B64 if it has special characters.
MAILBOX_PASSWORD=CHANGE-ME
# MAILBOX_PASSWORD_B64=

# Optional: where the admin "Send test email" button sends to.
TEST_EMAIL_TO=
