# Application
APP_NAME="D&J Webmail"
# Local: http://localhost/webmail
# Production: https://mailbox.djgroupllc.net (see deploy/env.production.example)
APP_URL=http://localhost/webmail
APP_DEBUG=true
SESSION_LIFETIME=28800
MAIL_PER_PAGE=15
FILTER_BATCH_LIMIT=500

# --- Performance / polling (tune per server) ---
# Seconds between the gentle background new-mail check. 60 suits a dedicated
# server; a constrained shared host may prefer 120. Floored at 15.
LIVE_SYNC_INTERVAL=60
# Seconds between open-folder message polls.
MAIL_POLL_INTERVAL=30
# Minimum seconds between automatic filter passes (mail routed into folders).
# 30 for a dedicated server; raise (e.g. 60) on a constrained shared host.
FILTER_MIN_INTERVAL=30

# Database
# Local WAMP:
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=dj_webmail
DB_USER=root
DB_PASSWORD=
# Or use base64 for special characters: DB_PASSWORD_B64=
# Hostinger production: see deploy/.env.production

# Shared mailbox (IMAP/SMTP)
IMAP_HOST=p3plzcpnl507129.prod.phx3.secureserver.net
IMAP_PORT=993
IMAP_ENCRYPTION=ssl
IMAP_VALIDATE_CERT=false

SMTP_HOST=p3plzcpnl507129.prod.phx3.secureserver.net
SMTP_PORT=465
SMTP_ENCRYPTION=ssl
SMTP_VALIDATE_CERT=false

MAILBOX_EMAIL=support@bebenailsmd.com
MAILBOX_PASSWORD=

# Optional: recipient for admin "Send test email" button
TEST_EMAIL_TO=
